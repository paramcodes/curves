{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "typecheck": {
      "inputs": ["$TURBO_DEFAULT$", "../../packages/*/src/**", "../../packages/*/package.json"]
    },
    "test": {
      "inputs": ["$TURBO_DEFAULT$", "../../packages/*/src/**", "../../packages/*/package.json"]
    },
    "test:integration": {
      "inputs": ["$TURBO_DEFAULT$", "../../packages/*/src/**", "../../packages/*/package.json"]
    }
  }
}
