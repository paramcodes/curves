{
  "$schema": "https://unpkg.com/knip@6.42.1/schema.json",
  "workspaces": {
    "apps/web": {
      "entry": "src/entry.ts"
    },
    "packages/api": {
      "entry": "src/entry.ts"
    },
    "packages/db": {
      "entry": ["src/entry.ts", "src/schema/*.ts", "src/test-db.ts"]
    },
    "packages/domain": {
      "entry": [
        "src/entry.ts",
        "src/core/*.ts",
        "src/teams/*.ts",
        "src/issues/*.ts",
        "src/projects/*.ts",
        "src/cycles/*.ts",
        "src/activities/*.ts",
        "src/notifications/*.ts",
        "src/filters/*.ts"
      ]
    },
    "packages/ui": {
      "entry": "src/entry.ts"
    }
  }
}
